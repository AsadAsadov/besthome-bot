# --- Telegram bot (required for telegram_main.py) ---
BOT_TOKEN=1234567890:YOUR_TELEGRAM_BOT_TOKEN
# Use one of the two options below:
ADMIN_ID=1311851277
# ADMIN_IDS=1311851277,987654321

# --- Optional runtime settings ---
ENV=prod
BASE_DATA_DIR=/tmp/besthome
# DATA_DIR is kept as backward-compatible alias for BASE_DATA_DIR
# DATA_DIR=/tmp/besthome
BESTHOME_DB_PATH=/tmp/besthome/besthome.db
WEB_APP_URL=https://your-domain.onrender.com
PUBLIC_WEB_APP_URL=https://your-domain.onrender.com
PUBLIC_BASE_URL=https://your-domain.onrender.com
AUTO_UPDATE_SENDER_IDS=
CARD_PAYMENT_URL=

# --- Instagram/Meta webhook app settings (required only for main.py web app) ---
META_VERIFY_TOKEN=your_meta_verify_token
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
INSTAGRAM_API_VERSION=v20.0
